map $http_cookie $headlamp_sso_suppressed {
    default 0;
    ~*(^|\;\s*)headlamp-sso-suppress=1(?:\;|$) 1;
}

map $headlamp_sso_suppressed $headlamp_sso_suppress_clear {
    default "";
    1 "headlamp-sso-suppress=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Lax";
}

server {
    listen 80;
    listen [::]:80;
    server_name headlamp.lazycampus.com;
    access_log off;

    # OIDC ID tokens may span more than one cookie and WebSocket upgrades are
    # more sensitive to request-header limits than ordinary API requests.
    large_client_header_buffers 4 64k;

    # Tencent EdgeOne terminates public HTTPS and reaches this origin over HTTP.
    # Start OIDC before rendering Headlamp's local login screen. Headlamp clears
    # its own token through this endpoint when the user explicitly logs out; the
    # short-lived marker lets the next root view render once instead of
    # immediately recreating the session.
    location = /clusters/main/set-token {
        proxy_pass http://127.0.0.1:32080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        add_header Set-Cookie "headlamp-sso-suppress=1; Path=/; Max-Age=120; Secure; HttpOnly; SameSite=Lax" always;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = / {
        add_header Set-Cookie $headlamp_sso_suppress_clear always;

        if ($headlamp_sso_suppressed = 0) {
            return 302 https://headlamp.lazycampus.com/oidc?cluster=main;
        }

        proxy_pass http://127.0.0.1:32080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Headlamp normally completes OIDC inside a popup. The platform also starts
    # OIDC as a top-level navigation, so complete both modes explicitly: notify
    # and close a popup, or continue a top-level window to the main cluster.
    location = /auth {
        default_type text/html;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 200 '<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>正在完成登录</title><style>body{font-family:system-ui,sans-serif;margin:0;min-height:100vh;display:grid;place-items:center;color:#334155;background:#f8fafc}</style></head><body><p>正在进入控制台…</p><script>(function(){if(window.opener&&!window.opener.closed){localStorage.setItem("auth_status","success");window.close();return;}window.location.replace("/c/main/");})();</script></body></html>';
    }

    location / {
        proxy_pass http://127.0.0.1:32080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
