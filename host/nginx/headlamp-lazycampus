server {
    listen 80;
    listen [::]:80;
    server_name headlamp.lazycampus.com;
    access_log off;

    # OIDC ID tokens may span more than one cookie and WebSocket upgrades are
    # more sensitive to request-header limits than ordinary API requests.
    large_client_header_buffers 4 64k;

    # Tencent EdgeOne terminates public HTTPS and reaches this origin over HTTP.
    location / {
        proxy_pass http://127.0.0.1:32080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
