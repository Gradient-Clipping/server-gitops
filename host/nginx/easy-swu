# EdgeOne Free does not provide a maintained origin CIDR allowlist. Trust its
# client IP only when the Easy SWU origin key also matches. The key is generated
# on the host and installed in EdgeOne as a SET (not ADD) request-header rule.
# A missing key file keeps the direct-peer fallback, including on first install.
map $http_x_easy_swu_origin_key $easy_swu_origin_authenticated {
    default 0;
    include /etc/nginx/private/easy-swu-origin-keys/*.conf;
}

map $easy_swu_origin_authenticated $easy_swu_origin_ip_candidate {
    default $remote_addr;
    1 $http_eo_connecting_ip;
}

# geo parses both IPv4 and IPv6; invalid/missing addresses become 255.255.255.255.
geo $easy_swu_origin_ip_candidate $easy_swu_origin_ip_valid {
    default 1;
    255.255.255.255 0;
}

map "$easy_swu_origin_authenticated:$easy_swu_origin_ip_valid" $easy_swu_client_ip {
    default $remote_addr;
    "1:1" $easy_swu_origin_ip_candidate;
}

map $http_upgrade $easy_swu_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name easy-api.lazycampus.com;

    # Tencent EdgeOne terminates public HTTPS and reaches this origin over HTTP.
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:32080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $easy_swu_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $easy_swu_client_ip;
        proxy_set_header X-Forwarded-For $easy_swu_client_ip;
        # Never expose the origin credential to Traefik, API logs or the app.
        proxy_set_header X-Easy-SWU-Origin-Key "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name easy-admin.lazycampus.com;

    # The admin uploads publication media through its same-origin API proxy.
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:32080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $easy_swu_client_ip;
        proxy_set_header X-Forwarded-For $easy_swu_client_ip;
        proxy_set_header X-Easy-SWU-Origin-Key "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
