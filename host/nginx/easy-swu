server {
    listen 80;
    listen [::]:80;
    server_name easy-api.lazycampus.com;

    # Tencent EdgeOne terminates public HTTPS and reaches this origin over HTTP.
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:32080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace caller-supplied chains. Only configure real_ip_header with
        # verified EdgeOne source CIDRs; otherwise remote_addr is the edge IP.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}

