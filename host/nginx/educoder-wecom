# Callback query strings and encrypted payloads must not enter access logs.
map $http_x_educoder_origin_key $educoder_origin_authenticated {
    default 0;
    include /etc/nginx/private/educoder-origin-keys/*.conf;
}

server {
    listen 80;
    listen [::]:80;
    server_name educoder.lazycampus.com;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 64k;
    client_body_timeout 5s;

    if ($educoder_origin_authenticated = 0) { return 403; }

    location ~ ^/(callbacks/wecom/kf|healthz|readyz)$ {
        proxy_pass http://127.0.0.1:32080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Educoder-Origin-Key "";
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
    }
    location / { return 404; }
}
