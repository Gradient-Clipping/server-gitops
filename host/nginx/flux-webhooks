# EdgeOne terminates HTTPS. Flux verifies the GitHub HMAC before reconciling.
limit_req_zone $binary_remote_addr zone=flux_webhooks:1m rate=10r/s;
server {
    listen 80;
    listen [::]:80;
    server_name hooks.lazycampus.com;
    access_log off;
    # GitHub webhook payloads may be up to 25 MB.
    client_max_body_size 26m;
    limit_req_status 429;

    location /hook/ {
        limit_except POST { deny all; }
        limit_req zone=flux_webhooks burst=30 nodelay;
        proxy_pass http://127.0.0.1:32080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }
    location / { return 404; }
}
