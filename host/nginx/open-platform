# Trust EdgeOne client IPs only with the per-platform origin credential.
map $http_x_platform_origin_key $platform_origin_authenticated {
    default 0;
    include /etc/nginx/private/platform-origin-keys/*.conf;
}
map $platform_origin_authenticated $platform_origin_ip_candidate {
    default $remote_addr;
    1 $http_eo_connecting_ip;
}
geo $platform_origin_ip_candidate $platform_origin_ip_valid {
    default 1;
    255.255.255.255 0;
}
map "$platform_origin_authenticated:$platform_origin_ip_valid" $platform_client_ip {
    default $remote_addr;
    "1:1" $platform_origin_ip_candidate;
}
limit_req_zone $platform_client_ip zone=platform_ingress:10m rate=10r/s;

server {
    listen 80;
    listen [::]:80;
    server_name platform.lazycampus.com;
    access_log off;
    client_max_body_size 32k;
    limit_req_status 429;

    location /internal/ { return 404; }
    location / {
        limit_req zone=platform_ingress burst=30 nodelay;
        proxy_pass http://127.0.0.1:32080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $platform_client_ip;
        proxy_set_header X-Forwarded-For $platform_client_ip;
        proxy_set_header X-Platform-Origin-Key "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 100s;
        proxy_send_timeout 100s;
    }
}
