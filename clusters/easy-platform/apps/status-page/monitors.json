{
  "groups": [
    {
      "id": "homepage",
      "name": "Lazy Campus 主页",
      "namespaces": [
        "lazycampus-site"
      ]
    },
    {
      "id": "smart-shop",
      "name": "Smart Shop",
      "namespaces": [
        "smart-shop"
      ]
    },
    {
      "id": "easy-swu",
      "name": "Easy SWU 小程序",
      "namespaces": [
        "easy-swu"
      ]
    },
    {
      "id": "open-platform",
      "name": "开放平台",
      "namespaces": [
        "open-platform"
      ]
    },
    {
      "id": "identity",
      "name": "统一登录",
      "namespaces": [
        "identity-system"
      ]
    }
  ],
  "monitors": [
    {
      "id": "homepage-web",
      "group": "homepage",
      "name": "网站访问",
      "kind": "http",
      "target": "https://lazycampus.com/",
      "public": true,
      "incidentGroup": "homepage",
      "description": "",
      "publicUrl": "https://lazycampus.com"
    },
    {
      "id": "homepage-assets",
      "group": "homepage",
      "name": "页面资源",
      "kind": "http",
      "target": "https://lazycampus.com/",
      "public": true,
      "incidentGroup": "homepage",
      "description": "",
      "assetCheck": true,
      "intervalSeconds": 60
    },
    {
      "id": "shop-web",
      "group": "smart-shop",
      "name": "商城页面",
      "kind": "http",
      "target": "https://shop.lazycampus.com/",
      "public": true,
      "incidentGroup": "smart-shop",
      "description": "",
      "publicUrl": "https://shop.lazycampus.com"
    },
    {
      "id": "shop-catalog",
      "group": "smart-shop",
      "name": "商品与库存",
      "kind": "http",
      "target": "http://smart-shop-backend.smart-shop.svc.cluster.local:9099/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "smart-shop",
      "description": "商品及库存读取与近期请求情况。",
      "reportKey": "catalog",
      "credentialRef": "shop",
      "reportTTLSeconds": 100,
      "dependencies": [
        "shop-api"
      ]
    },
    {
      "id": "shop-orders",
      "group": "smart-shop",
      "name": "购物车与订单",
      "kind": "http",
      "target": "http://smart-shop-backend.smart-shop.svc.cluster.local:9099/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "smart-shop",
      "description": "购物车、订单读取与近期请求情况。",
      "reportKey": "orders",
      "credentialRef": "shop",
      "reportTTLSeconds": 100,
      "dependencies": [
        "shop-api"
      ]
    },
    {
      "id": "shop-payments",
      "group": "smart-shop",
      "name": "支付信息与订单确认",
      "kind": "http",
      "target": "http://smart-shop-backend.smart-shop.svc.cluster.local:9099/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "smart-shop",
      "description": "收款信息及订单记录读取；不执行付款。",
      "reportKey": "payments",
      "credentialRef": "shop",
      "reportTTLSeconds": 100,
      "dependencies": [
        "shop-api"
      ]
    },
    {
      "id": "easy-swu-api",
      "group": "easy-swu",
      "name": "API 接入",
      "kind": "http",
      "target": "http://api.easy-swu.svc.cluster.local:3000/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "easy-swu",
      "description": "小程序接口接入与核心依赖。",
      "reportKey": "api",
      "credentialRef": "easy-swu",
      "reportTTLSeconds": 100
    },
    {
      "id": "easy-swu-teaching",
      "group": "easy-swu",
      "name": "教务查询",
      "kind": "http",
      "target": "http://api.easy-swu.svc.cluster.local:3000/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "easy-swu",
      "description": "课表、成绩、考试、空教室及校历。",
      "reportKey": "teaching",
      "credentialRef": "easy-swu",
      "reportTTLSeconds": 100
    },
    {
      "id": "easy-swu-content",
      "group": "easy-swu",
      "name": "校园资讯",
      "kind": "http",
      "target": "http://api.easy-swu.svc.cluster.local:3000/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "easy-swu",
      "description": "校园消息、公告与通知。",
      "reportKey": "content",
      "credentialRef": "easy-swu",
      "reportTTLSeconds": 100
    },
    {
      "id": "easy-swu-utilities",
      "group": "easy-swu",
      "name": "生活服务",
      "kind": "http",
      "target": "http://api.easy-swu.svc.cluster.local:3000/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "easy-swu",
      "description": "电费与校园生活查询。",
      "reportKey": "utilities",
      "credentialRef": "easy-swu",
      "reportTTLSeconds": 100
    },
    {
      "id": "easy-swu-tasks",
      "group": "easy-swu",
      "name": "自动任务",
      "kind": "http",
      "target": "http://api.easy-swu.svc.cluster.local:3000/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "easy-swu",
      "description": "自动查询、数据更新及定时任务。",
      "reportKey": "tasks",
      "credentialRef": "easy-swu",
      "reportTTLSeconds": 100
    },
    {
      "id": "platform-web",
      "group": "open-platform",
      "name": "开发者控制台",
      "kind": "http",
      "target": "https://platform.lazycampus.com/",
      "public": true,
      "incidentGroup": "open-platform",
      "description": "",
      "publicUrl": "https://platform.lazycampus.com"
    },
    {
      "id": "platform-auth",
      "group": "open-platform",
      "name": "应用授权与限流",
      "kind": "http",
      "target": "http://platform.open-platform.svc.cluster.local:3000/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "open-platform",
      "description": "应用权限配置与限流服务。",
      "reportKey": "authorization",
      "credentialRef": "platform",
      "reportTTLSeconds": 100
    },
    {
      "id": "platform-campus",
      "group": "open-platform",
      "name": "校园开放接口",
      "kind": "http",
      "target": "http://platform.open-platform.svc.cluster.local:3000/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "open-platform",
      "description": "已接入校园开放接口的近期调用情况。",
      "reportKey": "campus",
      "credentialRef": "platform",
      "reportTTLSeconds": 100
    },
    {
      "id": "platform-mail",
      "group": "open-platform",
      "name": "通知邮件",
      "kind": "http",
      "target": "http://platform.open-platform.svc.cluster.local:3000/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "open-platform",
      "description": "通知队列处理与邮件投递情况。",
      "reportKey": "mail",
      "credentialRef": "platform",
      "reportTTLSeconds": 100
    },
    {
      "id": "identity-sso",
      "group": "identity",
      "name": "统一登录入口",
      "kind": "http",
      "target": "https://auth.lazycampus.com/realms/lazycampus/.well-known/openid-configuration",
      "public": true,
      "incidentGroup": "identity",
      "description": "",
      "contains": "\"issuer\""
    },
    {
      "id": "identity-school",
      "group": "identity",
      "name": "学校身份认证",
      "kind": "http",
      "target": "http://identity-bridge.identity-system.svc.cluster.local:3000/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "identity",
      "description": "学校账户认证的近期结果。",
      "reportKey": "campus",
      "credentialRef": "identity",
      "reportTTLSeconds": 100
    },
    {
      "id": "identity-sessions",
      "group": "identity",
      "name": "会话与令牌",
      "kind": "http",
      "target": "http://identity-bridge.identity-system.svc.cluster.local:3000/internal/monitoring/v1/state",
      "public": true,
      "incidentGroup": "identity",
      "description": "校园身份会话与令牌的近期处理结果。",
      "reportKey": "sessions",
      "credentialRef": "identity",
      "reportTTLSeconds": 100
    },
    {
      "id": "shop-api",
      "group": "smart-shop",
      "name": "业务 API",
      "kind": "http",
      "target": "https://shop-api.lazycampus.com/healthz",
      "contains": "\"success\":true",
      "description": "商品、订单与账户服务。",
      "public": false,
      "dependencies": [
        "k8s:smart-shop:deployment:smart-shop-backend",
        "k8s:smart-shop:deployment:smart-shop-redis"
      ]
    },
    {
      "id": "platform-api",
      "group": "open-platform",
      "name": "开放 API 网关",
      "kind": "http",
      "target": "https://platform.lazycampus.com/readyz",
      "contains": "\"status\":\"ready\"",
      "description": "开发者应用授权与校园开放接口。",
      "public": false,
      "dependencies": [
        "k8s:open-platform:deployment:platform",
        "k8s:open-platform:deployment:platform-redis",
        "k8s:easy-swu:deployment:easy-swu-api"
      ]
    },
    {
      "id": "identity-campus",
      "group": "identity",
      "name": "学校账户登录",
      "kind": "http",
      "target": "https://auth.lazycampus.com/campus/.well-known/openid-configuration",
      "contains": "\"issuer\"",
      "public": false,
      "dependencies": [
        "k8s:identity-system:deployment:identity-bridge"
      ]
    }
  ]
}
